# apps/bbs — copy to .env for `vp run dev`. Every variable is validated at boot (src/config.ts).

# The PLATFORM origin: issuer = ${PUBLIC_ORIGIN}/auth, audiences ${PUBLIC_ORIGIN}/api/bbs and /mcp/bbs.
PUBLIC_ORIGIN=http://localhost:3000
# THIS app's origin (cookies, redirect URI ${APP_ORIGIN}/callback, og:url). Dev: the Vite server on :3003.
APP_ORIGIN=http://localhost:3003
# Where this process reaches services/auth (JWKS, token endpoint, user-info). Defaults to PUBLIC_ORIGIN.
#AUTH_INTERNAL_URL=http://auth:3001

# postgres://…/bbs in compose; pglite://memory or pglite:///abs/path locally (pg_trgm is loaded for you).
DATABASE_URL=pglite:///tmp/herkules-bbs-pglite
# Same value services/auth seeds the confidential `bbs` client with.
BBS_CLIENT_SECRET=
# ≥ 32 chars; seals the session cookie. Rotating it signs every browser out.
BBS_COOKIE_SECRET=
# Built SPA directory (index.html + assets/). Unset in dev: the Vite dev server serves the SPA.
#WEB_DIR=/app/dist/client
# trgm (default, stock Postgres) | pgroonga (the check-5 fallback; needs the custom image)
SEARCH_INDEX=trgm
# false when the role may not CREATE DATABASE; then run `createdb bbs` once yourself.
BBS_CREATE_DATABASE=true

# The Hono process. In dev the Vite server owns :3003 and proxies here.
PORT=3103
NODE_ENV=development
