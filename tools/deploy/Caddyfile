# Cloudflare terminates public TLS; production Caddy requires the host-owned Origin CA pair.
# The laptop overlay selects local_http and supplies explicit HTTP addresses.
# This file is bind-mounted from the active release, not baked into the image, so routing
# changes ship with a push and no image rebuild; the applicator recreates caddy when the
# Caddy configuration digest changes. Only the SPA in /srv comes from the image (Dockerfile,
# `caddy` stage: services/web's build output).
# Each MCP server adds one file under caddy/services/ (see bbs.caddy).
# Cloudflare's published proxy ranges, checked 2026-09-12.
# https://www.cloudflare.com/ips-v4/ and https://www.cloudflare.com/ips-v6/
{
 servers {
  trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
  client_ip_headers CF-Connecting-IP
  trusted_proxies_strict
 }
}

(origin_tls) {
	tls /run/origin-tls/origin.pem /run/origin-tls/origin.key
}

(local_http) {
}

(common_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	import {$CADDY_TLS_MODE:origin_tls}
	import common_headers
	# Caddy orders `handle` blocks by path specificity, so the catch-all below always loses to these.
	handle /ai {
		redir https://ai-portal.herkules.dev 302
	}
	handle /auth/internal/* {
		respond 404
	}
	handle /auth/* {
		reverse_proxy auth:3001
	}
	handle /.well-known/* {
		reverse_proxy auth:3001
	}
	import services/*.caddy
	# services/web's SPA, straight off disk. Hashed filenames under /assets are immutable;
	# index.html must be revalidated or a deploy never reaches an open tab.
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Every document, "/" included, not just the literal /index.html: try_files rewrites after
		# headers are matched, so a path matcher on /index.html would leave "/" cacheable and a
		# deploy would not reach an open tab.
		@document not path /assets/*
		header @document Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# apps/bbs — its own origin (cookies, OAuth redirect URI); the API, the SPA and
# head injection are all one container. Its MCP path stays on the platform
# origin (caddy/services/bbs.caddy). Must be a top-level block: the services
# glob above is imported inside {$SITE_ADDRESS}.
{$BBS_SITE_ADDRESS} {
	encode zstd gzip
	import {$CADDY_TLS_MODE:origin_tls}
	import common_headers
	reverse_proxy bbs:3003
}

# ── monitoring (docker-compose.yml gatus / beszel; README "Monitoring") ──────
# The defaults keep this file valid in dev, where neither host is configured.
# Public status page: no auth (gatus.yaml only checks public URLs).
{$STATUS_HOST:status.localhost} {
	encode zstd gzip
	import {$CADDY_TLS_MODE:origin_tls}
	import common_headers
	reverse_proxy gatus:8080
}

# Beszel hub. Its own sign-in is the herkules auth service (OIDC), so no edge auth
# here — a basic_auth in front would also break the agents' WebSocket handshake.
# PocketBase's superuser UI (/_/) is break-glass: blocked at the edge, reach it with
# `ssh -L 8090:127.0.0.1:8090` + `docker compose port beszel 8090` (README).
{$OPS_HOST:ops.localhost} {
	import {$CADDY_TLS_MODE:origin_tls}
	import common_headers
	@superuser path /_/*
	respond @superuser 403
	reverse_proxy beszel:8090
}

# AI stays unavailable until the opt-in Compose profile has been provisioned.
{$AI_HOST:ai.herkules.dev}, {$AI_PORTAL_HOST:ai-portal.herkules.dev} {
 import {$CADDY_TLS_MODE:origin_tls}
 import common_headers
 reverse_proxy inference:4010 {
  flush_interval -1
  header_up -X-Herkules-Ticket
  header_up X-Herkules-Client-IP {client_ip}
 }
}
