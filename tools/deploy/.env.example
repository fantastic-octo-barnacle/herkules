# tools/deploy/.env — on the box at ~/herkules/.env (never committed). Both compose files read it;
# auth and backup also receive every line (extra variables are ignored by the auth service).

# ── where ─────────────────────────────────────────────────────────────────────
# Caddy site address: the bare hostname in production (automatic TLS), http://localhost:3000 in dev.
SITE_ADDRESS=herkules.dev
PUBLIC_ORIGIN=https://herkules.dev
# Images built by .github/workflows/images.yml. Dev builds locally and ignores the registry.
IMAGE_PREFIX=ghcr.io/<owner>/herkules
IMAGE_TAG=latest

# ── auth service ──────────────────────────────────────────────────────────────
# openssl rand -base64 48
AUTH_SECRET=
# GitHub OAuth app (one per environment). Callback URL: ${PUBLIC_ORIGIN}/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The organization whose active members are admitted (the app needs read:org, which it requests itself).
GITHUB_ORG=
# Seed admins by GitHub login, comma-separated. Promotes at boot and first login; never demotes.
ADMIN_GITHUB_LOGINS=
NODE_ENV=production

# ── postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── backup to Cloudflare R2 (backup service) ─────────────────────────────────
R2_BUCKET=
R2_PREFIX=herkules
BACKUP_KEEP_DAYS=30
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACL=private
