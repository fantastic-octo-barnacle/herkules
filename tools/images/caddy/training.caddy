root * /srv/training
# Cache only existing fingerprinted assets, never asset 404s or lesson HTML.
@immutable {
	path /assets/*
	file
}
header @immutable Cache-Control "public, max-age=31536000, immutable"
@documents not path /assets/*
header @documents Cache-Control "no-cache"
# VitePress clean URLs: missing pages remain genuine 404s, never the homepage.
try_files {path} {path}.html {path}/index.html =404
file_server
handle_errors {
	header Cache-Control "no-cache"
	rewrite * /404.html
	file_server
}
