[Unit]
Description=Herkules AI worker admission and streaming adapter
After=network-online.target llama-server.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/node /opt/herkules-ai/worker.mjs
LoadCredential=llama-key:/etc/herkules-ai/worker.key
LoadCredential=worker-key:/etc/herkules-ai/adapter.key
Environment=LLAMA_KEY_FILE=%d/llama-key WORKER_KEY_FILE=%d/worker-key
Environment=WORKER_MODEL=qwen3.8-27b WORKER_CONTEXT=131072 PORT=8081
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
