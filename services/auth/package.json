{
  "name": "@herkules/auth",
  "version": "0.0.0",
  "private": true,
  "description": "herkules authorization server: Hono + Better Auth 1.7 issuer at https://herkules.dev/auth (GitHub gate, roles, OAuth 2.1 for MCP clients, registry PRM, user-info, audit).",
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "exports": {
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env --experimental-strip-types src/main.ts",
    "start": "node --experimental-strip-types src/main.ts",
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check",
    "db:schema": "node --experimental-strip-types scripts/generate-schema.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@better-auth/mcp": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@herkules/auth-middleware": "workspace:*",
    "@hono/node-server": "catalog:",
    "better-auth": "1.7.2",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.2",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
