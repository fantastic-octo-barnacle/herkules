# services/auth — copy to .env for local dev (`vp run dev`). Every variable is validated at boot (src/config.ts).
PUBLIC_ORIGIN=http://localhost:3000
AUTH_SECRET=change-me-to-at-least-32-random-characters
# postgres://user:pass@host:5432/db in compose; pglite://memory or pglite:///abs/path for local dev
DATABASE_URL=pglite:///tmp/herkules-auth-pglite
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=
# Seed admins by GitHub login (comma-separated). Promotes at boot and first login; never demotes.
ADMIN_GITHUB_LOGINS=
AVATAR_DIR=/tmp/herkules-avatars
PORT=3001
# Caddy's address(es) for X-Forwarded-For trust; empty locally.
TRUSTED_PROXIES=
# Seconds a grant may reuse the last gate verdict before re-asking GitHub.
GATE_RECHECK_TTL=600
# Seconds a prior allow survives a GitHub outage at grant time.
GATE_STALE_MAX=86400
# Unused dynamically registered clients older than this (seconds) are pruned daily.
DCR_PRUNE_AFTER=2592000
NODE_ENV=development
# Client ID Metadata Documents (client_id is an HTTPS URL the issuer fetches). Off by default: the
# production host cannot reach claude.ai/chatgpt.com (docs/auth.md). DCR stays on either way.
CIMD_ENABLED=false
# Optional allowlist of CIMD client_id origins, comma-separated. Empty: any public origin.
CIMD_ALLOWED_ORIGINS=
# apps/bbs: set both to seed the confidential first-party `bbs` client (redirect `${BBS_ORIGIN}/callback`); leave both empty otherwise.
BBS_ORIGIN=http://localhost:3003
BBS_CLIENT_SECRET=

# Optional AI portal: use a dedicated random secret shared with the inference gateway.
# Leave all three unset to keep AI disabled. Production uses https://ai-portal.herkules.dev.
# AI_PORTAL_ORIGIN=http://localhost:4010
# AI_CLIENT_SECRET=<at-least-32-random-characters>
# AI_SYNC_SECRET=<a-separate-at-least-32-random-character-secret>
