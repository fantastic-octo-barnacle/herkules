{
  "name": "@herkules/mcp-directory",
  "version": "0.0.0",
  "private": true,
  "description": "herkules directory: the self-test MCP server at https://herkules.dev/mcp/directory (whoami, list_members, get_member) verifying tokens with @herkules/auth-middleware and reading the auth service's user-info API.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --experimental-strip-types src/main.ts",
    "start": "node --experimental-strip-types src/main.ts",
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@herkules/auth-middleware": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/server": "2.0.0",
    "hono": "^4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@herkules/auth": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
