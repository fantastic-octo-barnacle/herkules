# services/mcp-directory — copy to .env for `vp run dev`.

# Public origin of the single-origin deployment. The resource is ${PUBLIC_ORIGIN}/mcp/directory
# and the issuer ${PUBLIC_ORIGIN}/auth; both must match what services/auth was started with.
PUBLIC_ORIGIN=http://localhost:3000

# Where THIS process reaches the auth service (JWKS, user-info API). Defaults to PUBLIC_ORIGIN;
# in compose it is the container address, e.g. http://auth:3001.
#AUTH_INTERNAL_URL=http://auth:3001

PORT=3002
NODE_ENV=development
